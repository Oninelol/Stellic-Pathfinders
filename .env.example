# Copy to .env for local development. Never commit a real .env.

# Where user data lives. SQLite by default — one file, no Docker.
# Postgres later is a connection-string change only.
DATABASE_URL=sqlite:///./compass.db

# Signs session tokens. MUST be set to a long random value in production;
# changing it signs everyone out. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Frontend origin allowed by CORS in production (local dev origins are always allowed).
# FRONTEND_ORIGIN=https://your-frontend.example
